{
  "name": "lysbot-merge-action",
  "version": "1.0.0",
  "description": "GitHub Action for automated PR merging with validation checks",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/main.ts --source-map --license licenses.txt --minify",
    "postbuild": "npm run normalize:sourcemaps",
    "normalize:sourcemaps": "node scripts/normalize-sourcemaps.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run test:coverage",
    "upgrade": "npx --yes npm-check-updates -u && npm install",
    "build:full": "npm run check && npm run build",
    "build:upgrade": "npm run upgrade && npm run format && npm run build:full",
    "build:full-upgrade": "npx --yes rimraf dist package-lock.json && npm run build:upgrade"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "auto-merge",
    "automation",
    "github-action",
    "merge",
    "pull-request",
    "validation"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^2.0.0",
    "@actions/github": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.3",
    "@vercel/ncc": "^0.38.4",
    "@vitest/coverage-v8": "^4.0.15",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.0.15"
  }
}
